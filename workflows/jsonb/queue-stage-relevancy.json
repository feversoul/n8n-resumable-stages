    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE events_jsonb\nSET status = CASE WHEN status @> to_jsonb($2::text) THEN status ELSE status || to_jsonb($2::text) END\nWHERE id = $1\nRETURNING id, title, status",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.tag] }}"
        }
      },
