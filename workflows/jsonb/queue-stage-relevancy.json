        0,
        0
      ],
      "id": "c6c16467-f5e4-46ff-8b1e-7f24c85904c4",
      "name": "When called by the parent"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, status\nFROM events_jsonb\nWHERE status ?| ARRAY['duplicate', 'unique']\n  AND NOT status ?| ARRAY['relevant', 'irrelevant']\nORDER BY id",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
