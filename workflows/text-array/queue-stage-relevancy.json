    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE events\nSET status = CASE WHEN status @> ARRAY[$2::text] THEN status ELSE array_append(status, $2::text) END\nWHERE id = $1\nRETURNING id, title, status",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.tag] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
