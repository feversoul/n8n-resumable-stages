      "position": [
        0,
        0
      ],
      "id": "aea03063-539d-4c01-8cf2-8761060ef616",
      "name": "When called by the parent"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, status\nFROM events\nWHERE status && ARRAY['duplicate', 'unique']\n  AND NOT status && ARRAY['relevant', 'irrelevant']\nORDER BY id",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
